# DeckSmith Batch Processing System - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================
# Environment: development, homologation, production
DECKSMITH_ENVIRONMENT=development

# Application version (automatically set in CI/CD)
DECKSMITH_VERSION=v1.0.0

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Database connection (for local development)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=decksmith_dev
DATABASE_USER=decksmith_user
DATABASE_PASSWORD=your_password_here

# Or use DATABASE_URL for Heroku Postgres
# DATABASE_URL=postgresql://username:password@hostname:port/database

# Database pool settings
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=10
DATABASE_COMMAND_TIMEOUT=60
DATABASE_SSL_MODE=prefer

# ============================================================================
# MACHINE LEARNING CONFIGURATION
# ============================================================================
# Enable Deep Learning features
ML_ENABLE_DEEP_LEARNING=true

# GPU settings
ML_USE_GPU=false
ML_GPU_MEMORY_GROWTH=true
ML_MIXED_PRECISION=true

# Training parameters
ML_BATCH_SIZE=32
ML_EPOCHS=10
ML_LEARNING_RATE=0.001

# Model directories
ML_MODELS_DIR=./models
ML_DATA_DIR=./data
ML_TEMP_DIR=./temp

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Base API URL
API_BASE_URL=http://localhost:8000

# API timeouts and limits
API_TIMEOUT=30
API_MAX_RETRIES=3
API_RATE_LIMIT=100

# External API keys (per environment)
SCRYFALL_API_KEY_DEV=your_scryfall_key_dev
SCRYFALL_API_KEY_HOM=your_scryfall_key_hom
SCRYFALL_API_KEY_PROD=your_scryfall_key_prod

EDHREC_API_KEY_DEV=your_edhrec_key_dev
EDHREC_API_KEY_HOM=your_edhrec_key_hom
EDHREC_API_KEY_PROD=your_edhrec_key_prod

MTGJSON_API_KEY_DEV=your_mtgjson_key_dev
MTGJSON_API_KEY_HOM=your_mtgjson_key_hom
MTGJSON_API_KEY_PROD=your_mtgjson_key_prod

# ============================================================================
# MONITORING AND LOGGING
# ============================================================================
# Monitoring settings
MONITORING_ENABLED=true
MONITORING_LOG_LEVEL=INFO
MONITORING_METRICS_RETENTION_DAYS=30

# Sentry DSN (per environment)
SENTRY_DSN_DEV=your_sentry_dsn_dev
SENTRY_DSN_HOM=your_sentry_dsn_hom
SENTRY_DSN_PROD=your_sentry_dsn_prod

# ============================================================================
# NOTIFICATIONS
# ============================================================================
# Notification settings
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_ON_ERROR=true
NOTIFICATIONS_ON_SUCCESS=false
NOTIFICATIONS_ON_COMPLETION=true

# Slack webhooks (per environment)
SLACK_WEBHOOK_DEV=your_slack_webhook_dev
SLACK_WEBHOOK_HOM=your_slack_webhook_hom
SLACK_WEBHOOK_PROD=your_slack_webhook_prod

# Teams webhooks (per environment)
TEAMS_WEBHOOK_DEV=your_teams_webhook_dev
TEAMS_WEBHOOK_HOM=your_teams_webhook_hom
TEAMS_WEBHOOK_PROD=your_teams_webhook_prod

# Email notifications
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_SMTP_SERVER=smtp.gmail.com
NOTIFICATIONS_SMTP_PORT=587
NOTIFICATIONS_SMTP_USERNAME=your_email@gmail.com
NOTIFICATIONS_SMTP_PASSWORD=your_app_password
NOTIFICATIONS_EMAIL_FROM=decksmith@example.com
NOTIFICATIONS_EMAIL_TO=admin@example.com

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Application secrets
DECKSMITH_API_KEY=your_api_key_here
DECKSMITH_SECRET_KEY=your_secret_key_here
DECKSMITH_JWT_SECRET=your_jwt_secret_here
DECKSMITH_ENCRYPTION_KEY=your_encryption_key_here

# Rate limiting
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_REQUESTS=100
SECURITY_RATE_LIMIT_WINDOW=3600

# IP whitelist (comma-separated)
SECURITY_IP_WHITELIST=

# User agent verification
SECURITY_USER_AGENT_VERIFICATION=false

# ============================================================================
# SCRAPING CONFIGURATION
# ============================================================================
# Scraping settings
SCRAPING_BASE_URL=https://ligamagic.com.br
SCRAPING_USER_AGENT=DeckSmith Bot 1.0
SCRAPING_DEFAULT_DELAY=1.0
SCRAPING_MAX_DELAY=5.0
SCRAPING_TIMEOUT=30
SCRAPING_MAX_RETRIES=3
SCRAPING_CONCURRENT_WORKERS=4
SCRAPING_USE_PROXY=false
SCRAPING_STEALTH_MODE=true
SCRAPING_ROTATE_HEADERS=true
SCRAPING_MAX_PAGES_PER_SESSION=1000

# Proxy list (comma-separated)
SCRAPING_PROXY_LIST=

# ============================================================================
# EXPORT CONFIGURATION
# ============================================================================
# Export settings
EXPORT_OUTPUT_DIR=./exports
EXPORT_TEMP_DIR=./temp
EXPORT_DEFAULT_FORMAT=parquet
EXPORT_COMPRESSION=snappy
EXPORT_BATCH_SIZE=10000
EXPORT_MAX_FILE_SIZE_MB=500
EXPORT_INCLUDE_METADATA=true
EXPORT_PARTITION_BY=formato
EXPORT_CLEANUP_TEMP=true
EXPORT_VERIFY=true
EXPORT_BACKUP=false
EXPORT_RETENTION_DAYS=30

# ============================================================================
# HEROKU SPECIFIC (for deployment)
# ============================================================================
# These are automatically set by Heroku, but can be overridden
PORT=8000
WEB_CONCURRENCY=2
PYTHONHASHSEED=random

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================
# Debug settings (development only)
DEBUG=false
VERBOSE_LOGGING=false
ENABLE_PROFILING=false

# Test database (for running tests)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decksmith_test